# ReconcileAI Environment Configuration (Educational / Buildathon Prototype)

# Database configuration (SQLite for local testing, PostgreSQL ready)
DATABASE_URL=sqlite:///./reconcile_ai.db

# Webhook Security (Educational HMAC-SHA256 secret)
WEBHOOK_SECRET=reconcile_ai_secret_key_buildathon_2026

# AI Reasoning Configuration
# Set to false to use the built-in deterministic financial heuristic reasoning engine
# Set to true if you wish to connect an external LLM API (OpenAI, Groq, Gemini, etc.)
AI_ENABLED=false
LLM_PROVIDER=heuristic
LLM_API_KEY=

# Gemini Configuration (Official google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Ports
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
